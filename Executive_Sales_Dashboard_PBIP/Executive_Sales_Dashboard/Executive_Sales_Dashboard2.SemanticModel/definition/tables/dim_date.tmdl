		summarizeBy: none
		sourceColumn: year_month

		annotation SummarizationSetBy = Automatic

	column day_of_week_number
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: a9024f38-291b-5129-8423-76700ce7ebbe
		summarizeBy: none
		sourceColumn: day_of_week_number

		annotation SummarizationSetBy = Automatic

	partition dim_date = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataFolder & "\dim_date.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Promoted = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Typed = Table.TransformColumnTypes(Promoted, {{"date", type date}, {"date_key", Int64.Type}, {"year", Int64.Type}, {"quarter", type text}, {"month_number", Int64.Type}, {"month_name", type text}, {"week_of_year", Int64.Type}, {"day_name", type text}, {"is_weekend", type logical}}, "en-US"),
					AddYM = Table.AddColumn(Typed, "year_month", each Date.ToText([date], "yyyy-MM", "en-US"), type text),
					AddDow = Table.AddColumn(AddYM, "day_of_week_number", each Date.DayOfWeek([date], Day.Monday) + 1, Int64.Type)
				in
					AddDow

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

