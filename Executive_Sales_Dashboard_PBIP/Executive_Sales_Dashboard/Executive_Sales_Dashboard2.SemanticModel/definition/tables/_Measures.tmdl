		lineageTag: 7988b2d7-0b56-5afa-a140-14f15d00f241

	measure 'Profit Margin %' = DIVIDE([Total Profit], [Total Sales])
		formatString: 0.0%
		displayFolder: 1 Core
		lineageTag: a30de534-8066-53e5-b1a7-3a114575fa08

	measure 'Discount %' = DIVIDE([Total Discount], [Gross Sales])
