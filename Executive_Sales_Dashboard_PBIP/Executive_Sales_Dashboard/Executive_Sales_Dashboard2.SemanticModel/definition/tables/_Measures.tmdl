		lineageTag: bb3934af-0fac-57a7-a2b2-18e89b0e68cf

	measure 'Paid Order %' =
			DIVIDE(
			    CALCULATE(DISTINCTCOUNT(fact_sales[order_id]), fact_sales[payment_status] = "Paid"),
