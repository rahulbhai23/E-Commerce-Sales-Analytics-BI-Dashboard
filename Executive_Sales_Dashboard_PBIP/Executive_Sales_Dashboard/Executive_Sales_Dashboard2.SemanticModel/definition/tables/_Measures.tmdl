		displayFolder: 1 Core
		lineageTag: bd623b0f-1b48-51d5-8463-adb79d087375

	measure 'Total Orders' = DISTINCTCOUNT(fact_sales[order_id])
		formatString: #,0
		displayFolder: 1 Core
		lineageTag: d22950b0-b8cf-5cc7-8cc2-56a7b04c0093

	measure 'Total Customers' = DISTINCTCOUNT(fact_orders[customer_id])
		formatString: #,0
		displayFolder: 1 Core
		lineageTag: 966decd0-fb23-51dc-afeb-6bc21b298520

	measure 'Avg Order Value' = DIVIDE([Total Sales], [Total Orders])
		formatString: $#,0
		displayFolder: 1 Core
		lineageTag: fe2ef823-7748-525c-96c1-286edb37e971

	measure 'Orders per Customer' = DIVIDE([Total Orders], [Total Customers])
		formatString: 0.00
