		lineageTag: 9ab2859b-b739-5a01-a4cd-9ed2fd5659ed

	measure 'Loyalty Points Earned' = SUM(fact_orders[loyalty_points_earned])
		formatString: #,0
		displayFolder: 4 Customer
		lineageTag: bb1ce6e3-8690-5bdd-85c2-a5452cdc6e6b

	measure 'Loyalty Points Redeemed' = SUM(fact_orders[loyalty_points_redeemed])
		formatString: #,0
		displayFolder: 4 Customer
		lineageTag: f6c8675f-ad62-54fb-9d9d-4c4b72f26ae4

	measure 'Loyalty Redemption %' = DIVIDE([Loyalty Points Redeemed], [Loyalty Points Earned])
		formatString: 0.0%
		displayFolder: 4 Customer
		lineageTag: 1ed506cd-fdaf-5ae5-b39b-781c15db3ddf

	measure 'Returned Orders' = CALCULATE(DISTINCTCOUNT(fact_sales[order_id]), fact_sales[order_status] = "Returned")
		formatString: #,0
		displayFolder: 5 Operations
		lineageTag: 974aca55-81e1-5285-a3ab-3d7b055cddbe

	measure 'Cancelled Orders' = CALCULATE(DISTINCTCOUNT(fact_sales[order_id]), fact_sales[order_status] = "Cancelled")
