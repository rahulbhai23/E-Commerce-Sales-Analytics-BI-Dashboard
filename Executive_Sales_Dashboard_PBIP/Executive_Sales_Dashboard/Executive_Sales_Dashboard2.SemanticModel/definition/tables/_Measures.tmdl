		lineageTag: c83585fb-e042-5360-a374-4784da9d9b51

	measure 'Selected Year Count' = CALCULATE(DISTINCTCOUNT(dim_date[year]), ALLSELECTED(dim_date))
		formatString: 0
		isHidden
		displayFolder: 2 Time Intelligence
		lineageTag: 4be0b3e8-5bd2-5fbe-861e-b3a67020d19f

	measure 'Sales PY' =
			IF(
			    HASONEVALUE(dim_date[year]),
			    CALCULATE([Total Sales], SAMEPERIODLASTYEAR(dim_date[date]))
			)
		formatString: $#,0
		displayFolder: 2 Time Intelligence
		lineageTag: b8d9f64e-77ac-562e-928e-adf3819f9360

	measure 'Sales YoY %' = DIVIDE([Total Sales] - [Sales PY], [Sales PY])
		formatString: 0.0%
		displayFolder: 2 Time Intelligence
		lineageTag: 43a2f2d1-b6f6-5990-8d98-4d748d286cf5

	measure 'Sales PY (Trend)' = IF([Selected Year Count] = 1, [Sales PY])
		formatString: $#,0
		displayFolder: 2 Time Intelligence
		lineageTag: 067299f0-2e75-5235-9589-a36a415b15c9

	measure 'Profit PY' =
			IF(
			    HASONEVALUE(dim_date[year]),
			    CALCULATE([Total Profit], SAMEPERIODLASTYEAR(dim_date[date]))
			)
		formatString: $#,0
		displayFolder: 2 Time Intelligence
		lineageTag: 5c40277a-b1b2-508b-baf7-0b923efe4f95

	measure 'Profit YoY %' = DIVIDE([Total Profit] - [Profit PY], [Profit PY])
