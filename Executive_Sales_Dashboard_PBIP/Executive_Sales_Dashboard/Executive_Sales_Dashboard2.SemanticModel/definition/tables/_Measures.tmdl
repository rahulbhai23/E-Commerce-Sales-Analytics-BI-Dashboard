		lineageTag: c8b25d77-270d-5c07-ad06-b62b3e14e069

	measure 'Delivered Orders' =
			CALCULATE(
			    DISTINCTCOUNT(fact_sales[order_id]),
			    fact_sales[delivery_status] IN {"On Time", "Early", "Delayed"}
			)
		formatString: #,0
		displayFolder: 5 Operations
		lineageTag: 988ed877-cec4-5bc4-a5b0-ee09418f6c1e

	measure 'On-Time Orders' =
			CALCULATE(
			    DISTINCTCOUNT(fact_sales[order_id]),
			    fact_sales[delivery_status] IN {"On Time", "Early"}
			)
		formatString: #,0
		displayFolder: 5 Operations
		lineageTag: 8afd228e-eb77-5e2a-b414-ff39bbb53726

	measure 'On-Time Delivery %' = DIVIDE([On-Time Orders], [Delivered Orders])
		formatString: 0.0%
		displayFolder: 5 Operations
		lineageTag: 0c4397fb-0432-53d1-8136-0438a61ec1e8

	measure 'On-Time Target' = 0.9
		formatString: 0.0%
		displayFolder: 5 Operations
		lineageTag: 6be788a2-b7bb-5331-9a69-8bca733376ea

	measure 'Avg Customer Rating' = AVERAGE(fact_orders[customer_rating])
		formatString: 0.00
		displayFolder: 5 Operations
		lineageTag: 65fe880d-72ba-5d26-a9b6-c27aef6a48ce

	measure 'Positive Review %' =
			DIVIDE(
			    CALCULATE(COUNTROWS(fact_orders), fact_orders[review_sentiment] = "Positive"),
			    CALCULATE(COUNTROWS(fact_orders), fact_orders[review_sentiment] <> "No Review")
			)
		formatString: 0.0%
		displayFolder: 5 Operations
		lineageTag: 08f62fb7-a873-5bcf-bdb7-e31be1699e70

	measure 'Avg Delivery Days' = AVERAGE(fact_orders[delivery_days])
