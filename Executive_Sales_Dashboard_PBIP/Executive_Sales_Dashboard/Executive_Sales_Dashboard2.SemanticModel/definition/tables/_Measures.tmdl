	measure 'Avg Customer LTV' = AVERAGE(fact_orders[customer_lifetime_value])
		formatString: $#,0
		displayFolder: 4 Customer
		lineageTag: 905da28a-47dd-53ac-91a9-cae8023e89ba

	measure 'Repeat Order %' =
			DIVIDE(
			    CALCULATE(COUNTROWS(fact_orders), fact_orders[is_repeat_customer] = TRUE()),
			    COUNTROWS(fact_orders)
			)
		formatString: 0.0%
		displayFolder: 4 Customer
		lineageTag: 0b22b216-4c17-5c5f-981a-a15459226e97

	measure 'Avg CAC' = AVERAGE(dim_customer[customer_acquisition_cost])
		formatString: $#,0.00
