	measure 'Product Rank' =
			IF(
			    ISINSCOPE(dim_product[product_name]),
			    RANKX(ALL(dim_product[product_name]), [Total Sales], , DESC, Dense)
			)
		formatString: 0
		displayFolder: 3 Product & Rankings
		lineageTag: 3f8b13f9-ccee-5522-aa79-ffc963ca8466

	measure 'Top 10 Product Sales' = IF([Product Rank] <= 10, [Total Sales])
		formatString: $#,0
		displayFolder: 3 Product & Rankings
		lineageTag: 78e1c1da-13a7-5c8e-8bb3-ab43456b6fef

	measure 'Sales % of Total' = DIVIDE([Total Sales], CALCULATE([Total Sales], ALLSELECTED()))
