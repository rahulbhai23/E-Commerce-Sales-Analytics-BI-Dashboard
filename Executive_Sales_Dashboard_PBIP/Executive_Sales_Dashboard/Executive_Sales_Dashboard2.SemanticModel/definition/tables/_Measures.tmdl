	measure 'Sales YTD' = TOTALYTD([Total Sales], dim_date[date])
		formatString: $#,0
		displayFolder: 2 Time Intelligence
		lineageTag: 69d31848-7e58-5c55-ba21-8eab642efd79

	measure 'Sales MTD' = TOTALMTD([Total Sales], dim_date[date])
