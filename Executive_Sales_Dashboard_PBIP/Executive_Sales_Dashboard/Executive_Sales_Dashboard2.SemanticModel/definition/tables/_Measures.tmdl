			)
		formatString: 0.0%
		displayFolder: 5 Operations
		lineageTag: 74404299-e8b0-5e4c-b430-c1d4e1504a12

	measure 'YoY Color' = IF(ISBLANK([Sales YoY %]), "#6B7280", IF([Sales YoY %] >= 0, "#2E8B57", "#D64545"))
		displayFolder: 6 Formatting Helpers
		lineageTag: 601fdeb1-fc89-5b1b-ad06-49a9624b2bd6

	measure 'Sales YoY Label' =
